{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "paths": {
      "@anchor/shared": ["./packages/shared/src/index.ts"],
      "@anchor/shared/*": ["./packages/shared/src/*"]
    }
  }
}
